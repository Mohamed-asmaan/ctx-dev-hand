{
  "name": "ctx",
  "version": "0.1.0",
  "description": "Local fact engine for AI-assisted modernization: capture, gate, verify, handoff. Built for IBM Dev Day.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohamed-asmaan/ctx-dev-hand.git"
  },
  "homepage": "https://github.com/Mohamed-asmaan/ctx-dev-hand",
  "bugs": {
    "url": "https://github.com/Mohamed-asmaan/ctx-dev-hand/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "ctx": "./dist/cli.js",
    "ctx-mcp": "./dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "data",
    "samples",
    "scripts",
    ".cursor/hooks/ctx-gate.cjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "start": "node dist/cli.js engine start",
    "stop": "node dist/cli.js engine stop",
    "dev": "tsx src/cli.ts",
    "demo": "tsx scripts/demo-poc.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "vitest run --reporter=verbose tests/slow",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^4.0.0",
    "js-yaml": "^4.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
